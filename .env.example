# Copy to .env for local dev (or set these as Railway variables)
PORT=8090

# Postgres connection string. On Railway, add the Postgres plugin and this is injected automatically.
# Leave empty locally to use a JSON file in ./data
DATABASE_URL=

# Long random string. Sessions are invalidated if this changes.
JWT_SECRET=change-me-to-a-long-random-string

# Admin panel PIN (overrides assets/js/config.js)
ADMIN_PIN=2024

# Optional overrides for contact / payment details (otherwise assets/js/config.js or admin panel values are used)
WHATSAPP_NUMBER=919825744110
UPI_ID=escapecartel@upi
UPI_NAME=Escape Cartel
